# Neon Postgres（ダッシュボードの Connection string）
# アプリ実行用：プーラー経由（ホスト名に -pooler が付くもの）
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# マイグレーション用：直結（-pooler なし）
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# 生成例: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# ローカルは http://localhost:3000、本番は Vercel の URL
BETTER_AUTH_URL="http://localhost:3000"
